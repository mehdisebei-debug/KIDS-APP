# Copier ce fichier en .env.local et remplir les valeurs (ne jamais commiter .env.local)

# Supabase — clés publiques (lecture via RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — côté serveur uniquement (admin, scripts). Ne jamais exposer au navigateur.
SUPABASE_URL=                    # Optionnel : sinon NEXT_PUBLIC_SUPABASE_URL est utilisé
SUPABASE_SERVICE_ROLE_KEY=

# Mot de passe de l'espace /admin
ADMIN_PASSWORD=

# Carte Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=

# Scripts d'import
OPENAGENDA_API_KEY=              # scripts/import-openagenda.ts
GOOGLE_PLACES_API_KEY=           # (prévu) futur script Google Places
